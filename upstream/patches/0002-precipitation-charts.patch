diff --git a/server/views/simplified.py b/server/views/simplified.py
index 1d444e7..35b1b58 100644
--- a/server/views/simplified.py
+++ b/server/views/simplified.py
@@ -29,6 +29,85 @@ class SimplifiedPage(Page):
     def _script_tags(self, a):
         pass  # subclasses may add extra <script> tags in <head>
 
+    def _extra_body(self, a, **kwargs):
+        pass  # subclasses may append to the content section
+
+    def _precip_chart(self, a, forecasts, title):
+        """Chance-of-precipitation bars, for the empty lower half of a page.
+
+        Inline SVG rather than the canvas + rough.js the hourly page uses: no
+        script has to run before the screenshot is taken, so the chart cannot
+        come out half-drawn, and there is nothing to load.
+        """
+        forecasts = forecasts or []
+        if not forecasts:
+            return
+
+        probabilities = [f.get("rain_probability") or 0 for f in forecasts]
+        # Fixed 0-100% makes a 20% day look like a flat line. Scale to the
+        # window's peak, rounded up to a tidy step and floored at 40 so a dry
+        # window still reads as a chart. The top of scale is printed, and every
+        # bar keeps its true percentage, so nothing is overstated.
+        scale_max = max(40, min(100, -(-max(probabilities) // 20) * 20))
+
+        width, height = 1000.0, 300.0
+        pad_l, pad_r, pad_b, pad_t = 20.0, 20.0, 54.0, 34.0
+        plot_w = width - pad_l - pad_r
+        plot_h = height - pad_t - pad_b
+        slot = plot_w / len(forecasts)
+        bar_w = slot * 0.62
+
+        with a.div(id="day-precip"):
+            a.p(klass="day-precip-title", _t=title)
+            with a.svg(viewBox=f"0 0 {width:.0f} {height:.0f}",
+                       preserveAspectRatio="none", klass="day-precip-chart"):
+                with a.defs():
+                    with a.pattern(id="hatch", width="7", height="7",
+                                   patternUnits="userSpaceOnUse",
+                                   patternTransform="rotate(45)"):
+                        a.line(x1="0", y1="0", x2="0", y2="7",
+                               stroke="#000", **{"stroke-width": "2.4"})
+
+                baseline = pad_t + plot_h
+                # Half-scale guide, so a bar can be read at a glance
+                a.line(x1=f"{pad_l}", y1=f"{pad_t + plot_h / 2:.1f}",
+                       x2=f"{width - pad_r}", y2=f"{pad_t + plot_h / 2:.1f}",
+                       stroke="#000", **{"stroke-width": "1.5",
+                                         "stroke-dasharray": "6 9",
+                                         "opacity": "0.35"})
+                a.text(x=f"{pad_l + 4}", y=f"{pad_t - 6:.1f}",
+                       klass="day-precip-scale", _t=f"{scale_max}%")
+
+                for i, forecast in enumerate(forecasts):
+                    probability = forecast.get("rain_probability") or 0
+                    bar_h = plot_h * probability / scale_max
+                    x = pad_l + slot * i + (slot - bar_w) / 2
+
+                    if bar_h >= 1:
+                        for fill in ("url(#hatch)", "none"):
+                            a.rect(x=f"{x:.1f}", y=f"{baseline - bar_h:.1f}",
+                                   width=f"{bar_w:.1f}", height=f"{bar_h:.1f}",
+                                   fill=fill, stroke="#000",
+                                   **{"stroke-width": "3"})
+
+                    if probability >= max(5, scale_max * 0.12):
+                        a.text(x=f"{x + bar_w / 2:.1f}",
+                               y=f"{baseline - bar_h - 9:.1f}",
+                               klass="day-precip-value", _t=f"{probability}%")
+
+                    if i % 2 == 0:
+                        try:
+                            label = forecast["dt"].strftime("%-I%p").lower()
+                        except ValueError:
+                            label = forecast["dt"].strftime("%I%p").lower()
+                        a.text(x=f"{x + bar_w / 2:.1f}", y=f"{baseline + 34:.1f}",
+                               klass="day-precip-hour", _t=label)
+
+                a.line(x1=f"{pad_l}", y1=f"{baseline:.1f}",
+                       x2=f"{width - pad_r}", y2=f"{baseline:.1f}",
+                       stroke="#000", **{"stroke-width": "3"})
+
+
     def template(self, **kwargs):
         self.airium = Airium()
         a = self.airium
