+    def get_tomorrow_hourly(self, start_hour=6, end_hour=21, step=2) -> list:
+        """Tomorrow between `start_hour` and `end_hour`, every `step` hours."""
+        cached = self.cache.get("tomorrow_hourly")
+        if cached is not None:
+            return cached
+
+        data = self._fetch_forecast()
+        hourly = data["hourly"]
+        current_time = datetime.fromisoformat(data["current"]["time"])
+        tomorrow = (current_time + timedelta(days=1)).date()
+        times = [datetime.fromisoformat(t) for t in hourly["time"]]
+
+        indices = [
+            i for i, t in enumerate(times)
+            if t.date() == tomorrow and start_hour <= t.hour <= end_hour
+            and (t.hour - start_hour) % step == 0
+        ]
+
+        results = []
+        for i in indices:
+            results.append({
+                "dt": times[i],
+                "icon": self.get_icon(
+                    self._icon_key(hourly["weather_code"][i], hourly["is_day"][i])
+                ),
+                "temperature": {
+                    "unit": self._temp_unit,
+                    "value": round(hourly["temperature_2m"][i]),
+                },
+                "rain_probability": round(hourly["precipitation_probability"][i] or 0),
+            })
+
+        self.cache.set("tomorrow_hourly", results)
+        return results
+
